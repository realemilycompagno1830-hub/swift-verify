# ===========================================
# Swift Verify - Environment Variables
# Copy to .env.local and fill with real values
# NEVER commit real keys to Git
# ===========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMSPool
SMSPOOL_API_KEY=your-32-char-smspool-api-key
SMSPOOL_BASE_URL=https://api.smspool.net

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Monnify
NEXT_PUBLIC_MONNIFY_API_KEY=MK_TEST_xxx
MONNIFY_SECRET_KEY=your-monnify-secret
MONNIFY_CONTRACT_CODE=your-contract-code
NEXT_PUBLIC_MONNIFY_PUBLIC_KEY=MK_TEST_xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Swift Verify

# Optional: USD to NGN rate fallback (live rate preferred via API)
FALLBACK_USD_NGN_RATE=1600
